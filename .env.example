# Contoh saja: hostname web bebas dan tidak harus memakai prefix "app".
# Frontend dan Go API tetap disajikan pada origin yang sama.
VDO_PUBLIC_ORIGIN=https://app.example.com

# Hostname media bebas, menuju server yang sama, dan tercakup certificate.
VDO_MOQ_PUBLIC_BASE_URL=https://media.example.com:8892
VDO_SRT_PUBLIC_HOST=media.example.com
